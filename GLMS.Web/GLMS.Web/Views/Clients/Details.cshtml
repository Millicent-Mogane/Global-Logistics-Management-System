@model GLMS.Web.Models.Client

@{
    ViewData["Title"] = "Client Details";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Client Details</h3>
            </div>

            <div class="card-body">

                <dl class="row">

                    <dt class="col-sm-3">
                        Client Name
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-3">
                        Contact Details
                    </dt>

                    <dd class="col-sm-9">
                        @Model.ContactDetails
                    </dd>

                    <dt class="col-sm-3">
                        Region
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Region
                    </dd>

                </dl>

                <div class="mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.ClientId"
                       class="btn btn-warning">
                        Edit Client
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>