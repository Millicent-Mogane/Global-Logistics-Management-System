@model GLMS.Web.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">Delete Client</h3>
            </div>

            <div class="card-body">

                <div class="alert alert-warning">
                    Are you sure you want to delete this client?
                </div>

                <dl class="row">

                    <dt class="col-sm-3">
                        Client Name
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-3">
                        Contact Details
                    </dt>

                    <dd class="col-sm-9">
                        @Model.ContactDetails
                    </dd>

                    <dt class="col-sm-3">
                        Region
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Region
                    </dd>

                </dl>

                <div class="mt-4">

                    <form asp-action="Delete">

                        <input type="hidden" asp-for="ClientId" />

                        <button type="submit"
                                class="btn btn-danger">
                            Delete Client
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to List
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>