@model GLMS.Web.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Contract Details</h3>
            </div>

            <div class="card-body">

                <dl class="row">

                    <dt class="col-sm-3">
                        Start Date
                    </dt>

                    <dd class="col-sm-9">
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </dd>

                    <dt class="col-sm-3">
                        End Date
                    </dt>

                    <dd class="col-sm-9">
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </dd>

                    <dt class="col-sm-3">
                        Status
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Status
                    </dd>

                    <dt class="col-sm-3">
                        Service Level
                    </dt>

                    <dd class="col-sm-9">
                        @Model.ServiceLevel
                    </dd>

                    <dt class="col-sm-3">
                        Signed Agreement
                    </dt>

                    <dd class="col-sm-9">

                        @if (!string.IsNullOrEmpty(Model.AgreementFilePath))
                        {
                            <a asp-action="DownloadFile"
                               asp-route-fileName="@Model.AgreementFilePath"
                               class="btn btn-outline-info btn-sm">
                                Download PDF
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                No File Uploaded
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-3">
                        Client
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Client?.Name
                    </dd>

                </dl>

                <div class="mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.ContractId"
                       class="btn btn-warning">
                        Edit Contract
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to List
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>