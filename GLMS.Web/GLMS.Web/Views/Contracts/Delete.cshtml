@model GLMS.Web.Models.Contract

@{
    ViewData["Title"] = "Delete Contract";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">Delete Contract</h3>
            </div>

            <div class="card-body">

                <div class="alert alert-warning">
                    Are you sure you want to delete this contract?
                </div>

                <dl class="row">

                    <dt class="col-sm-3">
                        Start Date
                    </dt>

                    <dd class="col-sm-9">
                        @Model.StartDate.ToString("dd MMM yyyy")
                    </dd>

                    <dt class="col-sm-3">
                        End Date
                    </dt>

                    <dd class="col-sm-9">
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </dd>

                    <dt class="col-sm-3">
                        Status
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Status
                    </dd>

                    <dt class="col-sm-3">
                        Service Level
                    </dt>

                    <dd class="col-sm-9">
                        @Model.ServiceLevel
                    </dd>

                    <dt class="col-sm-3">
                        Signed Agreement
                    </dt>

                    <dd class="col-sm-9">

                        @if (!string.IsNullOrEmpty(Model.AgreementFilePath))
                        {
                            <span class="text-success">
                                PDF Uploaded
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No File
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-3">
                        Client
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Client?.Name
                    </dd>

                </dl>

                <div class="mt-4">

                    <form asp-action="Delete">

                        <input type="hidden" asp-for="ContractId" />

                        <button type="submit"
                                class="btn btn-danger">
                            Delete Contract
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to List
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>