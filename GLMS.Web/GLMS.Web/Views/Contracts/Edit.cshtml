@model GLMS.Web.Models.Contract

@{
    ViewData["Title"] = "Edit Contract";
}

<div class="row justify-content-center">

    <div class="col-lg-6">

        <div class="card shadow-sm">

            <div class="card-header bg-warning">
                <h3 class="mb-0">Edit Contract</h3>
            </div>

            <div class="card-body">

                <form asp-action="Edit">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <input type="hidden" asp-for="ContractId" />
                    <input type="hidden" asp-for="AgreementFilePath" />

                    <div class="mb-3">

                        <label asp-for="StartDate"
                               class="form-label">
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="EndDate"
                               class="form-label">
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Status"
                               class="form-label">
                        </label>

                        <select asp-for="Status"
                                class="form-control">
                            <option value="Draft">Draft</option>
                            <option value="Active">Active</option>
                            <option value="Expired">Expired</option>
                            <option value="On Hold">On Hold</option>
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="ServiceLevel"
                               class="form-label">
                        </label>

                        <input asp-for="ServiceLevel"
                               class="form-control" />

                        <span asp-validation-for="ServiceLevel"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-bold">
                            Current Agreement
                        </label>

                        @if (!string.IsNullOrEmpty(Model.AgreementFilePath))
                        {
                            <div class="text-success fw-bold mb-2">
                                ✓ Agreement Available
                            </div>

                            <a asp-action="DownloadFile"
                               asp-route-fileName="@Model.AgreementFilePath"
                               class="btn btn-outline-info btn-sm">
                                Download PDF
                            </a>
                        }
                        else
                        {
                            <div class="text-muted">
                                No Agreement Uploaded
                            </div>
                        }

                    </div>

                    <div class="mb-3">

                        <label asp-for="ClientId"
                               class="form-label">
                        </label>

                        <select asp-for="ClientId"
                                class="form-control"
                                asp-items="ViewBag.ClientId">
                        </select>

                        <span asp-validation-for="ClientId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-success">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to List
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}