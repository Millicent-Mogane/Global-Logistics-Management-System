@model IEnumerable<GLMS.Web.Models.Contract>

@{
    ViewData["Title"] = "Contracts";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="mb-0">Contracts</h1>

    <a asp-action="Create" class="btn btn-success">
        Create New Contract
    </a>

</div>

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form method="get" asp-action="Index">

            <div class="row">

                <div class="col-md-3">
                    <label class="form-label">Status</label>

                    <select name="statusFilter" class="form-control">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Active">Active</option>
                        <option value="Expired">Expired</option>
                        <option value="On Hold">On Hold</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Start Date</label>

                    <input type="date"
                           name="startDate"
                           class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">End Date</label>

                    <input type="date"
                           name="endDate"
                           class="form-control" />
                </div>

                <div class="col-md-3 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary me-2">
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </div>

        </form>

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Service Level</th>
                        <th>Agreement File</th>
                        <th>Client</th>

                        <th style="width:220px;">
                            Actions
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.StartDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.EndDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.ServiceLevel)
                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(item.AgreementFilePath))
                                {
                                    <a asp-action="DownloadFile"
                                       asp-route-fileName="@item.AgreementFilePath"
                                       class="btn btn-outline-info btn-sm">
                                        Download PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No File
                                    </span>
                                }

                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Client.Name)
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.ContractId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.ContractId"
                                   class="btn btn-primary btn-sm">
                                    Details
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.ContractId"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>