@model GLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Edit Service Request";
}

<div class="row justify-content-center">

    <div class="col-lg-6">

        <div class="card shadow-sm">

            <div class="card-header bg-warning">
                <h3 class="mb-0">Edit Service Request</h3>
            </div>

            <div class="card-body">

                <form asp-action="Edit">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <input type="hidden"
                           asp-for="ServiceRequestId" />

                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <input asp-for="Description"
                               class="form-control" />

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Cost"
                               class="form-label">
                        </label>

                        <input asp-for="Cost"
                               class="form-control" />

                        <span asp-validation-for="Cost"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Status"
                               class="form-label">
                        </label>

                        <select asp-for="Status"
                                class="form-control">

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="In Progress">
                                In Progress
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="ContractId"
                               class="form-label">
                        </label>

                        <select asp-for="ContractId"
                                class="form-control"
                                asp-items="ViewBag.ContractId">
                        </select>

                        <span asp-validation-for="ContractId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-success">
                            Save Changes
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to List
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}