@model GLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">Delete Service Request</h3>
            </div>

            <div class="card-body">

                <div class="alert alert-warning">
                    Are you sure you want to delete this service request?
                </div>

                <dl class="row">

                    <dt class="col-sm-3">
                        Description
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Description
                    </dd>

                    <dt class="col-sm-3">
                        Cost (ZAR)
                    </dt>

                    <dd class="col-sm-9">
                        R @Model.Cost.ToString("N2")
                    </dd>

                    <dt class="col-sm-3">
                        Status
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Status
                    </dd>

                    <dt class="col-sm-3">
                        Contract
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Contract?.ServiceLevel
                    </dd>

                </dl>

                <div class="mt-4">

                    <form asp-action="Delete">

                        <input type="hidden"
                               asp-for="ServiceRequestId" />

                        <button type="submit"
                                class="btn btn-danger">
                            Delete Service Request
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to List
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>