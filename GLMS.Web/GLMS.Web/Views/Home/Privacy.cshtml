@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">

    <div class="col-lg-10">

        <div class="card shadow-sm border-0">

            <div class="card-header text-white"
                 style="background: linear-gradient(135deg,#0f172a,#1e3a8a);">

                <h2 class="mb-2">Privacy Policy</h2>

                <p class="mb-0">
                    Global Logistics Management System (GLMS)
                </p>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <div class="card h-100 border-primary shadow-sm">

                            <div class="card-body">

                                <h5 class="text-primary">
                                    👥 Client Information
                                </h5>

                                <p>
                                    Client records, contact details and
                                    regional information are securely stored
                                    to support logistics operations and
                                    service delivery activities.
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card h-100 border-success shadow-sm">

                            <div class="card-body">

                                <h5 class="text-success">
                                    📄 Contract Management
                                </h5>

                                <p>
                                    Contract records and uploaded agreement
                                    documents are maintained within the system
                                    and accessible through authorized system
                                    functionality.
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card h-100 border-warning shadow-sm">

                            <div class="card-body">

                                <h5 class="text-warning">
                                    🛠 Service Requests
                                </h5>

                                <p>
                                    Service request data is maintained for
                                    operational tracking, reporting and
                                    business process management.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card shadow-sm mt-4">

                    <div class="card-body">

                        <h4>🔒 Data Integrity & Security</h4>

                        <p>
                            Users are responsible for ensuring that all
                            information entered into the system remains
                            accurate, complete and up to date.
                        </p>

                        <p>
                            Uploaded documents, contract information and
                            service request records are maintained to support
                            logistics management activities and reporting.
                        </p>

                    </div>

                </div>

                <div class="card shadow-sm mt-4">

                    <div class="card-body">

                        <h4>🏢 System Usage</h4>

                        <p>
                            GLMS is intended exclusively for authorized
                            business use and supports the management of
                            clients, contracts, service requests and
                            agreement documentation within a centralized
                            platform.
                        </p>

                    </div>

                </div>

                <div class="mt-4 text-center">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary btn-lg">
                        Return to Dashboard
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>